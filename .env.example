# Copy to .env (or set in your hosting dashboard). Defaults are for local development.
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_TIME_ZONE=Europe/London

# Database: sqlite (default) or postgres
DB_ENGINE=sqlite
DB_NAME=riceleaf
DB_USER=riceleaf
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Model
RICELEAF_MODEL_PATH=ml_models/model.npz
RICELEAF_UNCERTAINTY_THRESHOLD=0.6
RICELEAF_USE_TTA=1
RICELEAF_MAX_UPLOAD_MB=10
